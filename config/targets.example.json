{
  "targets": [
    {
      "name": "example-site",
      "url": "https://example.com",
      "host": "example.com",
      "checks": ["site", "ssl", "server", "logs"],
      "server_ports": [80, 443],
      "log_paths": ["/var/log/nginx/error.log"],
      "notification_targets": [
        {
          "name": "ops-email",
          "type": "email",
          "destination": "ops@example.com",
          "min_severity": "high",
          "enabled": true
        },
        {
          "name": "slack-webhook",
          "type": "slack",
          "destination": "https://hooks.slack.com/services/replace/me",
          "min_severity": "medium",
          "enabled": true
        },
        {
          "name": "local-file",
          "type": "file",
          "destination": "reports/example-site-notify.txt",
          "min_severity": "low",
          "enabled": true
        }
      ],
      "notes": "Sample monitoring target"
    }
  ]
}
